#!/bin/bash

# CloudCLI Wrapper Script
# Usage:
#   ./cloudcli              - Launch unified interface (login → menu)
#   ./cloudcli start        - Same as above
#   ./cloudcli shell        - Direct to command shell (legacy)
#   ./cloudcli interactive  - Direct to wizard (legacy)
#   ./cloudcli backup ...   - Direct backup command
#   ./cloudcli --help       - Show all commands

JAR_PATH="$(dirname "$0")/target/cloudcli-0.0.1-SNAPSHOT.jar"

if [ ! -f "$JAR_PATH" ]; then
    echo "❌ Error: JAR file not found at $JAR_PATH"
    echo "   Please build the project first: ./mvnw clean package -DskipTests"
    exit 1
fi

# Run the JAR with all arguments (defaults to "start" if no args)
java -jar "$JAR_PATH" "$@"
