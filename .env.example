# CloudCLI Environment Variables
# Copy this file to .env and fill in your values
# Load with: source .env

# ============================================
# DATABASE PASSWORDS
# ============================================
MYSQL_PASSWORD=your_mysql_password
POSTGRES_PASSWORD=your_postgres_password
MONGO_USERNAME=your_mongo_username
MONGO_PASSWORD=your_mongo_password
SUPABASE_PASSWORD=your_supabase_password

# ============================================
# AWS S3 CREDENTIALS
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============================================
# BACKBLAZE B2 CREDENTIALS
# Get from: https://secure.backblaze.com/app_keys.htm
# Free tier: 10GB storage, 1GB daily download
# ============================================
BACKBLAZE_KEY_ID=your_backblaze_key_id
BACKBLAZE_APP_KEY=your_backblaze_application_key

# ============================================
# WASABI CREDENTIALS
# Get from: https://console.wasabisys.com/#/access_keys
# Pricing: $5.99/TB/month, no egress fees
# ============================================
WASABI_ACCESS_KEY=your_wasabi_access_key
WASABI_SECRET_KEY=your_wasabi_secret_key

# ============================================
# EMAIL NOTIFICATION (Gmail)
# For Gmail: Use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
# ============================================
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ============================================
# SLACK NOTIFICATION
# Create webhook at: https://api.slack.com/messaging/webhooks
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
